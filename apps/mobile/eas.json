{
  "cli": {
    "version": ">=24.12.1",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "environment": "production",
      "distribution": "store",
      "autoIncrement": true
    }
  }
}
